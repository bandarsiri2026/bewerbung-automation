# Copy to .env (never commit the real .env)
OPENAI_API_KEY=your-openai-key-here

# Applicant profile — read by the "Applicant Profile" node in Workflow A
APPLICANT_NAME=Your Name
APPLICANT_ADDRESS=Street 1, 12345 City
APPLICANT_PHONE=0151-0000000
YOUR_EMAIL=you@example.com
FALLBACK_EMAIL=you@example.com

# Only needed by workflows/error-handler.sanitized.json
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Optional (only for the RAG workflow)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_API_KEY=your-supabase-key
